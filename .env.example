BOT_TOKEN=bot_token
ADMIN_IDS=[admin_id1, admin_id2]

# Environment: "development" (uses ngrok) or "production" (uses nginx + domain)
APP_ENV=development

# Base URL for webhook:
#   development: your ngrok domain (e.g. heroic-concise-halibut.ngrok-free.app)
#   production:  your domain with https (e.g. https://skaters.top)
BASE_URL=your_base_url

# Ngrok settings (only needed for development)
NGROK_AUTHTOKEN=your_ngrok_auth_token
NGROK_URL=your_ngrok_url
